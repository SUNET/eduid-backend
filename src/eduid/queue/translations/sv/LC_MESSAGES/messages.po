#: src/eduid/queue/templates/identity_expiry_warning_email.html.jinja2:5
#, python-format
msgid ""
"\n"
"    <p>Your identity verification at %(site_name)s expires on "
"%(expires_at)s.</p>\n"
"    <p>To keep your account verified, please log in and verify your "
"identity again before that date.</p>\n"
"    <p>(This is an automated email. Please do not reply.)</p>\n"
msgstr ""
"\n"
"    <p>Din identitet är verifierad hos %(site_name)s till och med "
"%(expires_at)s.</p>\n"
"    <p>För att behålla ditt verifierade konto, logga in och verifiera din"
" identitet igen innan dess.</p>\n"
"    <p>(Detta är ett automatiskt e-postmeddelande. Svara inte på "
"det.)</p>\n"

