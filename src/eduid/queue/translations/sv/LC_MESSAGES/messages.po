#: src/eduid/queue/templates/eduid_signup_email.html.jinja2:1
#, python-format
msgid ""
"\n"
"\n"
"<h2>Welcome to %(site_name)s,</h2>\n"
"\n"
"<p>You recently used %(email)s to sign up for %(site_name)s.</p>\n"
"\n"
"<p>To verify this email address belongs to you, enter the code below on "
"the email verification page:</p>\n"
"\n"
"<p>%(verification_code)s</p>\n"
"\n"
msgstr ""
"\n"
"\n"
"<h2>Välkommen till %(site_name)s,</h2>\n"
"\n"
"<p>Du har registrerat  %(email)s som e-postadress för %(site_name)s.</p>\n"
"\n"
"<p>Skriv in koden nedan på verifieringssidan för att visa att adressen "
"tillhör dig:</p>\n"
"\n"
"<p>%(verification_code)s</p>\n"
"\n"

