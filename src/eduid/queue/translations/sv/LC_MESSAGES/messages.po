#: src/eduid/queue/templates/reset_password_email.html.jinja2:1
#, python-format
msgid ""
"\n"
"<p>Hi,</p>\n"
"<p>You recently asked to reset your password for your %(site_name)s "
"account.</p>\n"
"<p>To verify this email address belongs to you, enter the code below on "
"the email verification page:</p>\n"
"\n"
"<p>%(verification_code)s</p>\n"
"\n"
"<p>The code is valid for %(password_reset_timeout)s hours.</p>\n"
"<p>(This is an automated email. Please do not reply.)</p>\n"
msgstr ""
"\n"
"<p>Hej,</p>\n"
"<p>Du har bett om att byta lösenord för ditt %(site_name)s-konto .</p>\n"
"<p>För att fortsätta byta lösenord skriv in koden nedan på "
"verifieringssidan:\n"
"<p>%(verification_code)s</p>\n"
"\n"
"<p>Koden är giltig i %(password_reset_timeout)s timmar.</p>\n"
"<p>(Detta är ett automatiserat meddelande och går ej att svara på.)</p>\n"

#: src/eduid/queue/templates/reset_password_email.txt.jinja2:1
#, python-format
msgid ""
"\n"
"Hi,\n"
"\n"
"You recently asked to reset your password for your %(site_name)s account."
"\n"
"\n"
"To verify this email address belongs to you, enter the code below on the "
"email verification page:\n"
"\n"
"%(verification_code)s\n"
"\n"
"The code is valid for %(password_reset_timeout)s hours.\n"
"\n"
"(This is an automated email. Please do not reply.)\n"
msgstr ""
"\n"
"Hej,\n"
"\n"
"Du har bett om att byta lösenord för ditt %(site_name)s-konto..\n"
"\n"
"För att fortsätta byta lösenord skriv in koden nedan på "
"verifieringssidan:\n"
"\n"
"%(verification_code)s\n"
"\n"
"Koden är giltig i  %(password_reset_timeout)s timmar.\n"
"\n"
"(Detta är ett automatiserat meddelande och går ej att svara på.)\n"

#: src/eduid/queue/templates/termination_email.html.jinja2:5
#, python-format
msgid ""
"\n"
"    <p>You have chosen to terminate your account at %(site_name)s.</p>\n"
"\n"
"    <p>If you don't do anything the account will automatically be removed"
" after one week.</p>\n"
"\n"
"    <p>If you want to keep your account, reset your password within one "
"week.</p>\n"
"\n"
"    <p>(This is an automated email. Please do not reply.)</p>\n"
msgstr ""
"\n"
"    <p>Du har valt att påbörja processen för att ta bort ditt konto hos "
"%(site_name)s.</p>\n"
"\n"
"    <p>Om du inte gör något så tas ditt konto bort om en vecka.</p>\n"
"\n"
"    <p>För att behålla kontot så behöver du återställa ditt lösenord inom"
" en vecka.</p>\n"
"\n"
"    <p>(Detta är ett automatiserat meddelande och går ej att svara "
"på.)</p>\n"

#: src/eduid/queue/templates/termination_email.txt.jinja2:2
#, python-format
msgid ""
"\n"
"    You have chosen to terminate your account at %(site_name)s.\n"
"\n"
"    If you don't do anything the account will automatically be removed "
"after one week.\n"
"\n"
"    If you want to keep your account, reset your password within one "
"week.\n"
"\n"
"    (This is an automated email. Please do not reply.)\n"
msgstr ""
"\n"
"    Du har valt att påbörja processen för att ta bort ditt konto hos "
"%(site_name)s.\n"
"\n"
"   Om du inte gör något så tas ditt konto bort om en vecka.\n"
"\n"
"    För att behålla kontot så behöver du återställa ditt lösenord inom en"
" vecka.\n"
"\n"
"    (Detta är ett automatiserat meddelande och går ej att svara på.)\n"

