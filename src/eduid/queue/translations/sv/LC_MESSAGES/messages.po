#: src/eduid/queue/templates/identity_unverified_email.html.jinja2:5
#, python-format
msgid ""
"\n"
"    <p>Your identity verification at %(site_name)s has expired and your "
"identity is no longer verified.</p>\n"
"    <p>To verify your identity again, please log in and follow the "
"instructions.</p>\n"
"    <p>(This is an automated email. Please do not reply.)</p>\n"
msgstr ""
"\n"
"    <p>Din identitetsverifiering hos %(site_name)s har gått ut och din "
"identitet är inte längre verifierad.</p>\n"
"    <p>För att verifiera din identitet igen, logga in och följ "
"instruktionerna.</p>\n"
"    <p>(Detta är ett automatiskt e-postmeddelande. Svara inte på "
"det.)</p>\n"

