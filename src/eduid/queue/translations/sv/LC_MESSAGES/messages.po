#: src/eduid/queue/templates/eduid_invite_mail_html.jinja2:3
#, python-format
msgid ""
"\n"
"    <p>You have been invited to create an eduID account by "
"%(inviter_name)s.</p>\n"
"\n"
"    <p>Please follow the link below to accept the invite and create your "
"account.</p>\n"
"\n"
"    <a href=\"%(invite_link)s\">%(invite_link)s</a>\n"
"\n"
"    <p>(This is an automated email. Please do not reply.)</p>\n"
msgstr ""
"\n"
"<p>Du har fått en inbjudan från %(inviter_name)s att skapa ett eduID-"
"konto.</p>\n"
"\n"
"<p>Följ länken nedan för att acceptera inbjudan och skapa ditt konto.</p>"
"\n"
"\n"
"<a href=\"%(invite_link)s\">%(invite_link)s</a>\n"
"\n"
"<p>(Detta är ett automatiserat meddelande och går ej att svara på.)</p>\n"

