{
	"name": "Python 3",
	"build": {
		"dockerfile": "Dockerfile",
		"context": "..",
		"options": ["--network=host"]
	},
	"customizations": {
		"vscode": {
			"settings": {
				"cSpell.language": "en-GB,en,sv",
				"python.defaultInterpreterPath": "${workspaceFolder}/.venv-devcontainer/bin/python"
			},
			"extensions": [
				"ms-python.python",
				"ms-python.vscode-pylance",
				"ms-python.mypy-type-checker",
				"tamasfe.even-better-toml",
				"ms-azuretools.vscode-docker",
				"GitHub.copilot-chat",
				"GitHub.vscode-pull-request-github",
				"streetsidesoftware.code-spell-checker",
				"streetsidesoftware.code-spell-checker-swedish",
				"ms-vscode.makefile-tools",
				"charliermarsh.ruff"
			]
		}
	},
	"postCreateCommand": "make bootstrap VENV=.venv-devcontainer",
	"mounts": [
		"type=bind,source=/var/run/docker.sock,target=/var/run/docker.sock"
	],
	"init": true,
	"remoteUser": "vscode",
	"runArgs": ["--network=host"],
	"overrideCommand": false
}